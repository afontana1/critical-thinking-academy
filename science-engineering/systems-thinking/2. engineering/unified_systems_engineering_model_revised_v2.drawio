    <diagram id="unified-systems-engineering" name="Unified Systems Engineering Model - Revised v2">
        <mxGraphModel dx="1018" dy="547" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
