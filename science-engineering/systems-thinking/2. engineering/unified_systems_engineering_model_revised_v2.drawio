                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="&lt;font style=&quot;font-size:24px;&quot;&gt;&lt;b&gt;Unified Systems Engineering Model&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px;&quot;&gt;Core Process + Core Views + Cross-Cutting Lenses&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="410" y="20" width="1100" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sec1" value="1. Problem Framing" style="swimlane;html=1;rounded=0;shadow=0;startSize=28;horizontal=0;fillColor=#f8f9fa;strokeColor=#444444;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="120" width="330" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="sec2" value="2. Concept and Boundary Definition" style="swimlane;html=1;rounded=0;shadow=0;startSize=28;horizontal=0;fillColor=#f8f9fa;strokeColor=#444444;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="410" y="120" width="350" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="sec3" value="3. Core System Views" style="swimlane;html=1;rounded=0;shadow=0;startSize=28;horizontal=0;fillColor=#fff7e6;strokeColor=#444444;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="800" y="120" width="770" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="sec4" value="4. Integration and Realization" style="swimlane;html=1;rounded=0;shadow=0;startSize=28;horizontal=0;fillColor=#f8f9fa;strokeColor=#444444;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1610" y="120" width="270" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="crosslane" value="Cross-Cutting Systems Thinking Lenses" style="swimlane;html=1;rounded=0;shadow=0;startSize=28;horizontal=0;fillColor=#eef5ff;strokeColor=#444444;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="800" y="620" width="1080" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="guide" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;1. Follow the solid arrows from left to right through the core process.&lt;br&gt;2. The orange/red boxes are the four main system views.&lt;br&gt;3. The blue lens boxes apply across those views and improve judgment throughout the process.&lt;br&gt;4. Dashed blue arrows show evidence-driven iteration; dashed red arrows show reframing from environmental discovery." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;" parent="1" vertex="1">
                    <mxGeometry x="40" y="620" width="720" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="N" value="&lt;b&gt;Need / Opportunity&lt;/b&gt;&lt;hr/&gt;What deficiency, risk, opportunity, or breakthrough motivates action?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="180" width="250" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="S" value="&lt;b&gt;Stakeholders&lt;/b&gt;&lt;hr/&gt;Identify active and passive stakeholders, including those affected indirectly" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="272" width="250" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="R" value="&lt;b&gt;Requirements&lt;/b&gt;&lt;hr/&gt;Capabilities, characteristics, constraints, priorities, and measurable success criteria" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="80" y="364" width="250" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="C" value="&lt;b&gt;Concept Generation &amp;amp; Selection&lt;/b&gt;&lt;hr&gt;Generate alternatives, compare concepts, make tradeoffs, trade space, option space, select promising direction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="455" y="210" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="B" value="&lt;b&gt;System Context &amp;amp; Boundary Definition&lt;/b&gt;&lt;hr/&gt;Define system-of-interest, external actors, upstream/downstream elements, and system boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="455" y="330" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="O" value="&lt;b&gt;Operational View&lt;/b&gt;&lt;hr/&gt;Use cases, scenarios, missions, workflows, operating modes, external interactions, system objectives" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9cb9c;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="835" y="240" width="170" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="F" value="&lt;b&gt;Functional View&lt;/b&gt;&lt;hr/&gt;Functions, behaviors, logical decomposition, control logic, internal flows, internal interfaces" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9cb9c;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1025" y="240" width="170" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="P" value="&lt;b&gt;Physical View&lt;/b&gt;&lt;hr/&gt;Components, subsystems, technologies, physical interfaces, implementation structure" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9cb9c;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1215" y="240" width="170" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="E" value="&lt;b&gt;Environmental View&lt;/b&gt;&lt;hr/&gt;Operating environment, disturbances, source-to-sink flows, dependencies, byproducts, unintended effects, impacts beyond the boundary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4cccc;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1405" y="230" width="140" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="M" value="&lt;b&gt;Integrated System Model&lt;/b&gt;&lt;hr/&gt;Unify views into one coherent representation for analysis, communication, and decision-making" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#444444;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1630" y="180" width="230" height="100" as="geometry"/>
                </mxCell>
